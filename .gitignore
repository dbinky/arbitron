.superpowers/
/arbitron
# Built binaries must never be committed — the only binaries users run are the
# cosign-signed release artifacts (see install.sh/install.ps1 verification gate).
*.exe
.env
node_modules/
dashboard/.vite/
.worktrees/
.claude/worktrees/
# SQLite runtime database (created by `arbitron serve`)
arbitron.db
arbitron.db-shm
arbitron.db-wal
# Runtime log
arbitron.log
# OTel trace exports
/traces/
# Per-run CI / test exhaust
testResults.xml
# Per-instance runtime workspaces (clones/worktrees created at execution)
workspaces/instances/
