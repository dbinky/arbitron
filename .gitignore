.superpowers/
/arbitron
# Built binaries must never be committed — the only binaries users run are the
# cosign-signed release artifacts (see install.sh verification gate).
*.exe
.env
node_modules/
dashboard/.vite/
.worktrees/
.claude/worktrees/
# Per-user Claude Code state
.claude/settings.local.json
.claude/scheduled_tasks.lock
# SQLite runtime database (created by `arbitron serve`)
arbitron.db
arbitron.db-shm
arbitron.db-wal
# Runtime log
arbitron.log
# OTel trace exports
/traces/
# Per-run CI / test exhaust
testResults.xml
# Per-instance runtime workspaces (clones/worktrees created at execution)
workspaces/instances/
# macOS Finder metadata
.DS_Store

# Release build output (make dist / make release)
/dist/
