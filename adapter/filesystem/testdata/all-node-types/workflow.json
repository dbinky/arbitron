{
  "name": "all-node-types",
  "description": "A workflow that exercises all five node types",
  "author": "test-author",
  "nodes": [
    {
      "id": "llm-node",
      "type": "llm_call",
      "label": "LLM Call",
      "entrypoint": true,
      "config": {
        "templateFile": "prompt.md",
        "model": "claude-sonnet-4-6",
        "maxTokens": 1000,
        "temperature": 0.7,
        "outputSchema": {"type": "object"}
      }
    },
    {
      "id": "script-node",
      "type": "script",
      "label": "Script",
      "config": {
        "scriptFile": "run.sh",
        "interpreter": "bash",
        "args": ["--input", "{{llm-node.result}}"],
        "timeoutSeconds": 30
      }
    },
    {
      "id": "tool-node",
      "type": "tool_call",
      "label": "Tool Call",
      "config": {
        "command": "git",
        "args": ["status"],
        "timeoutSeconds": 10
      }
    },
    {
      "id": "cond-node",
      "type": "conditional",
      "label": "Conditional",
      "config": {
        "conditions": [
          {"field": "score", "operator": "gt", "value": 80, "output": "high"}
        ],
        "defaultOutput": "low"
      }
    },
    {
      "id": "transform-node",
      "type": "transform",
      "label": "Transform",
      "config": {
        "operations": [
          {"variable": "result", "operation": "set", "value": "done"}
        ]
      }
    }
  ],
  "edges": [
    {"source": "llm-node", "target": "script-node"},
    {"source": "script-node", "target": "tool-node"},
    {"source": "tool-node", "target": "cond-node"},
    {"source": "cond-node", "target": "transform-node", "output": "high"},
    {"source": "cond-node", "target": "transform-node", "output": "low"}
  ]
}
