{
  "id": "4c8e1f3a-6b2d-4e97-a05c-d3f7b9e21c58",
  "name": "plan",
  "description": "Standalone planning stage. Checks out an existing pipeline branch, writes run-dated TDD task plans under docs/plans/<slug>/ from the spec and aligned designs, and aligns them. After every alignment pass a script audits the committed plans: a plan without checkbox steps gets one restore attempt and otherwise stops the stage. The dependency gates count BLOCKING/DECISION gap lines plus plan steps only a person can do; open items get up to TWO interactive resolve rounds (unrolled, never looped), each followed by a re-align and re-check; anything still open records the stage as blocked. Then pushes and records plan_paths[], deps_resolved and deps_gaps in the pipeline manifest.",
  "author": "arbitron",
  "inputs": [
    {
      "name": "repo_url",
      "type": "string",
      "description": "Repo to clone.",
      "required": true
    },
    {
      "name": "branch",
      "type": "string",
      "description": "Existing remote branch to check out and commit the plans on.",
      "required": true
    },
    {
      "name": "slug",
      "type": "string",
      "description": "Feature slug. Kept as given; plans live under docs/plans/<slug>/.",
      "required": true
    },
    {
      "name": "base_branch",
      "type": "string",
      "description": "Recorded as the manifest's top-level base_branch when this stage's finish creates the manifest. Empty leaves it unset.",
      "default": "",
      "required": false
    },
    {
      "name": "teams_webhook_url",
      "type": "string",
      "description": "Teams webhook URL, accepted for parity with the other stages. Leave empty in the committed sample.",
      "default": "",
      "required": false
    },
    {
      "name": "spec_path",
      "type": "string",
      "description": "Path of the approved spec on the branch. Falls back to the pipeline manifest's spec entry when empty.",
      "default": "",
      "required": false
    },
    {
      "name": "design_paths",
      "type": "array",
      "description": "Paths of the aligned phase designs on the branch. Falls back to the pipeline manifest's design entry when empty.",
      "default": [],
      "required": false
    }
  ],
  "nodes": [
    {
      "id": "init",
      "type": "script",
      "config": {
        "scriptFile": "@lib/init-workspace.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--checkout"
        ],
        "timeoutSeconds": 600
      },
      "label": "Init workspace",
      "description": "Clone repo_url and add a worktree at ./work on the existing remote branch.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 0
      },
      "entrypoint": true
    },
    {
      "id": "promote",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "work_dir",
            "operation": "set",
            "value": "{{init.work_dir}}"
          },
          {
            "variable": "run_date",
            "operation": "set",
            "value": "{{init.run_date}}"
          },
          {
            "variable": "plan_dir",
            "operation": "set",
            "value": "docs/plans/{{slug}}"
          }
        ]
      },
      "label": "Promote vars",
      "description": "Lift work_dir and run_date to top-level vars and compute the per-slug plan directory.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 140
      }
    },
    {
      "id": "resolve-inputs",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-read.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--explicit",
          "spec_path,design_paths",
          "--require",
          "spec_path,design_paths"
        ],
        "timeoutSeconds": 120
      },
      "label": "Resolve inputs",
      "description": "Explicit spec_path/design_paths win; otherwise both come from the manifest's spec and design entries. Both are required. design_paths stays a typed array.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 280
      }
    },
    {
      "id": "clear-plans",
      "type": "script",
      "config": {
        "scriptFile": "@lib/clear-owned-docs.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--message",
          "docs: clear {{slug}} plans for regeneration",
          "{{plan_dir}}/{{run_date}}-phase-*-task-*.md"
        ],
        "timeoutSeconds": 60
      },
      "label": "Clear this run's earlier plans",
      "description": "Reconciles this stage's owned file set before generating: removes today's <run_date>-phase-N-task-M.md plans under plan_dir (git rm + commit; history keeps them) so a same-day rerun with fewer phases cannot leave the first run's extra files for list-plans to publish. Refuses any pattern that is not a plan output.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 420
      }
    },
    {
      "id": "produce-plans",
      "type": "agent_call",
      "config": {
        "templateFile": "templates/produce-plans.md",
        "model_profile": "coder-opus-high",
        "timeoutSeconds": 14400
      },
      "label": "Produce plans",
      "description": "Write detailed TDD task plans for each design phase to ./work/docs/plans/<slug>/<run_date>-phase-N-task-M.md; commit locally.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 560
      }
    },
    {
      "id": "checkpoint-push-plans",
      "type": "script",
      "config": {
        "scriptFile": "@lib/checkpoint-push.sh",
        "interpreter": "/bin/sh",
        "args": [],
        "timeoutSeconds": 120
      },
      "label": "Checkpoint: push new plans",
      "description": "Pushes as soon as plans exist, before the dependency gate can route anywhere, so a blocked exit never loses the plan package.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 700
      }
    },
    {
      "id": "align-plans",
      "type": "agent_call",
      "config": {
        "templateFile": "templates/align-plans.md",
