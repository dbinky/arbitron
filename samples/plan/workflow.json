        "timeoutSeconds": 7200
      },
      "label": "Align plans",
      "description": "Align spec + designs + plans; fix in place; commit locally. Ends with the UNRESOLVED-DEPENDENCIES block deps-assess reads.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 840
      }
    },
    {
      "id": "deps-assess",
      "type": "llm_call",
      "config": {
        "templateFile": "templates/deps-assess.md",
        "model_profile": "assessor-opus-high",
        "outputSchema": {
          "properties": {
            "blocking_count": {
              "type": "number"
            },
            "gaps": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "has_blocking": {
              "type": "boolean"
            },
            "has_unresolved": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            },
            "unresolved_count": {
              "type": "number"
            }
          },
          "required": [
            "has_unresolved",
            "unresolved_count",
            "gaps",
            "notes"
          ],
          "type": "object"
        }
      },
      "label": "Assess plan dependencies",
      "description": "Read the align-plans report and list every open item as a BLOCKING:/DECISION:/NON-BLOCKING: gap line. Advisory only: the schema is not enforced, so the gate routes on deps-count.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 1680
      }
    },
    {
      "id": "deps-count",
      "type": "script",
      "config": {
        "scriptFile": "scripts/deps-count.sh",
        "interpreter": "/bin/sh",
        "args": [
          "deps-assess",
          "plan-audit",
          "recheck-plans"
        ],
        "timeoutSeconds": 60
      },
      "label": "Count gaps needing a person",
      "description": "Counts deps-assess's BLOCKING: and DECISION: gap lines plus the plan audit's human_only steps (needs_resolution), and emits the merged gaps list. Fails closed: unprefixed or malformed gaps, an LLM unresolved claim with nothing counted, or a missing audit all count.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 1820
      }
    },
    {
      "id": "deps-gate",
      "type": "conditional",
      "config": {
        "conditions": [
          {
            "field": "deps-count.needs_resolution",
            "operator": "eq",
            "value": 0,
            "output": "proceed"
          }
        ],
        "defaultOutput": "resolve"
      },
      "label": "Deps need a person?",
      "description": "Proceed only when deps-count.needs_resolution is 0. Otherwise the first human round (resolve-deps). Routes on deps-count (a script), never on deps-assess fields: llm_call outputSchema is not enforced, and run 5e86d796 sailed past 7 decisions on a first-match blocking_count == 0.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 1960
      }
    },
    {
      "id": "resolve-deps",
      "type": "interactive_agent",
      "config": {
        "templateFile": "templates/resolve-deps.md",
        "orchestrationFile": "orchestration/resolve-deps.orch.md",
        "model_profile": "interviewer-opus-high",
        "outputSchema": {
          "properties": {
            "notes": {
              "type": "string"
            },
            "updated_docs": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "updated_docs",
            "notes"
          ],
          "type": "object"
        }
      },
      "label": "Resolve dependencies (interactive)",
      "description": "First human round: walk the human through each gap in deps-count.gaps (BLOCKING/DECISION lines and HUMAN-ONLY plan steps), patch the design/plan docs, commit locally. Not on a cycle; never pushes.",
      "errorBehavior": {
        "type": "halt"
      },
      "position": {
        "x": 0,
        "y": 2100
      }
    },
