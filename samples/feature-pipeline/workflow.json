{
  "name": "feature-pipeline",
  "description": "End-to-end feature pipeline: clone a repo, interactively brainstorm a spec and phased designs, then automatically align docs, produce plans, checkpoint-push the plans, record a branch-point test baseline, implement task-by-task (TDD), refine via the native ralph loop (gating on no NEW failures vs the baseline, with a stagnation backstop), and open a PR. Self-contained: all brainstorming/planning/execution processes are native template content with no external skill dependency.",
  "author": "arbitron",
  "defaultErrorBehavior": {
    "type": "retry",
    "retries": 2,
    "retryDelaySeconds": 30
  },
  "inputs": [
    {
      "name": "repo_url",
      "type": "string",
      "description": "GitHub repo URL to clone and work in.",
      "required": true
    },
    {
      "name": "slug",
      "type": "string",
      "description": "Feature slug used for the branch name and docs. If empty, the branch uses a neutral 'feature' placeholder (never the repo name) and the real slug is resolved from the spec brainstorm for docs/templates.",
      "default": "",
      "required": false
    },
    {
      "name": "spec_only",
      "type": "boolean",
      "description": "Stop after the planning package (spec + designs + plans) is produced, committed, and pushed — before implementation begins. The plans are checkpoint-pushed on both paths.",
      "default": false,
      "required": false
    },
    {
      "name": "max_impl_iterations",
      "type": "number",
      "description": "Backstop cap on the draft-impl loop.",
      "default": 200,
      "required": false
    },
    {
      "name": "max_ralph_iterations",
      "type": "number",
      "description": "Backstop cap on the ralph refinement loop.",
      "default": 200,
      "required": false
    },
    {
      "name": "impl_iteration",
      "type": "number",
      "description": "Draft-impl loop counter.",
      "default": 0,
      "required": false
    },
    {
      "name": "ralph_iteration",
      "type": "number",
      "description": "Ralph loop counter.",
      "default": 0,
      "required": false
    },
    {
      "name": "no_progress_streak",
      "type": "number",
      "description": "Consecutive ralph passes that made no forward progress; the refine loop exits when this reaches 2 (stagnation backstop).",
      "default": 0,
      "required": false
    },
    {
      "name": "teams_webhook_url",
      "type": "string",
      "description": "Power Automate / Teams webhook URL for completion alerts. Leave empty in the committed sample (the notify-teams steps are no-ops when unset, or read ARBITRON_TEAMS_WEBHOOK_URL from the server env). The runtime workflow stores the real URL as this default.",
      "default": "",
      "required": false
    }
  ],
  "nodes": [
    {
      "id": "init-workspace",
      "type": "script",
      "config": {
        "scriptFile": "scripts/init-workspace.sh",
        "interpreter": "/bin/sh",
        "timeoutSeconds": 600
      },
      "label": "Init workspace",
      "description": "Clone repo_url into {{workspace}}/src, derive slug + run_date, create the dev-<slug>-<run_date>-<instance-short-id> worktree at {{workspace}}/work. The instance-id suffix keeps branches unique across concurrent runs of the same repo/feature.",
      "errorBehavior": {},
      "entrypoint": true,
      "position": {
        "x": 250,
        "y": 0
      }
    },
    {
      "id": "promote-vars",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "slug",
            "operation": "set",
            "value": "{{init-workspace.slug}}"
          },
          {
            "variable": "run_date",
            "operation": "set",
            "value": "{{init-workspace.run_date}}"
          },
          {
            "variable": "work_dir",
            "operation": "set",
            "value": "{{init-workspace.work_dir}}"
          },
          {
            "variable": "branch",
            "operation": "set",
            "value": "{{init-workspace.branch}}"
          }
        ]
      },
      "label": "Promote vars",
      "description": "Lift init-workspace outputs to top-level vars for clean downstream references.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "notify-start",
      "type": "script",
      "config": {
        "scriptFile": "scripts/notify.sh",
        "interpreter": "/bin/sh",
        "args": [
          "Feature pipeline started for {{slug}} on branch {{branch}} (repo {{repo_url}})."
        ],
        "timeoutSeconds": 30
      },
      "label": "Notify: started",
      "description": "In-app notification that the pipeline has started.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 320
      }
    },
    {
      "id": "brainstorm-spec",
      "type": "interactive_agent",
      "config": {
        "templateFile": "templates/brainstorm-spec.md",
        "model_profile": "interviewer-codex",
        "outputSchema": {
          "properties": {
            "slug": {
              "type": "string"
            },
            "spec_path": {
              "type": "string"
            }
          },
          "required": [
            "slug",
            "spec_path"
          ],
          "type": "object"
        },
        "orchestrationFile": "orchestration/brainstorm-spec.orch.md"
      },
      "label": "Brainstorm: spec",
      "description": "Interactive agent spec brainstorm; writes spec to disk and emits {slug, spec_path}.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 480
      }
    },
    {
      "id": "repromote-slug",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "slug",
            "operation": "set",
            "value": "{{brainstorm-spec.slug}}"
          }
        ]
      },
      "label": "Re-promote slug",
      "description": "After the spec brainstorm, set the global slug to the resolved feature slug the agent used, so designs/plans/templates all use one consistent slug.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 640
      }
    },
    {
      "id": "brainstorm-design",
      "type": "interactive_agent",
      "config": {
        "templateFile": "templates/brainstorm-design.md",
        "model_profile": "interviewer-opus-high",
        "outputSchema": {
          "properties": {
            "design_paths": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "slug": {
              "type": "string"
            }
          },
          "required": [
            "slug",
            "design_paths"
          ],
          "type": "object"
        },
        "orchestrationFile": "orchestration/brainstorm-design.orch.md"
      },
      "label": "Brainstorm: design",
      "description": "Interactive agent design brainstorm; writes design docs to disk and emits {slug, design_paths}.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 800
      }
    },
    {
      "id": "spec-only?",
      "type": "conditional",
      "config": {
        "conditions": [
          {
            "field": "spec_only",
            "operator": "eq",
            "value": true,
            "output": "stop"
          }
        ],
        "defaultOutput": "continue"
      },
      "label": "Spec only?",
      "description": "Gate AFTER planning + checkpoint push: if spec_only, stop with the spec/designs/plans pushed; else continue to baseline capture and the implementation loop.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 1600
      }
    },
    {
      "id": "align-designs",
      "type": "agent_call",
      "config": {
        "templateFile": "templates/align-designs.md",
        "model_profile": "planner-opus-medium",
        "timeoutSeconds": 1800
      },
      "label": "Align designs",
      "description": "Read spec + designs; fix alignment in place; commit.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 960
      }
    },
    {
      "id": "produce-plans",
      "type": "agent_call",
      "config": {
        "templateFile": "templates/produce-plans.md",
        "model_profile": "coder-GLM",
        "timeoutSeconds": 3600
      },
      "label": "Produce plans",
      "description": "Write detailed TDD task plans for each design phase; commit.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 1120
      }
    },
    {
      "id": "align-plans",
      "type": "agent_call",
      "config": {
        "templateFile": "templates/align-plans.md",
        "model_profile": "planner-opus-medium",
        "timeoutSeconds": 1800
      },
      "label": "Align plans",
      "description": "Align spec+designs+plans; fix in place; commit.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 1280
      }
    },
    {
      "id": "checkpoint-push",
      "type": "script",
      "config": {
        "scriptFile": "scripts/checkpoint-push.sh",
        "interpreter": "/bin/sh",
        "timeoutSeconds": 120
      },
      "label": "Checkpoint: push plans",
      "description": "Push the feature branch after the spec/design/plan phase so that expensive interactive+planning work survives a later crash/cancel/logout instead of living only in the instance worktree.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 1440
      }
    },
    {
      "id": "baseline-tests",
      "type": "agent_call",
      "config": {
        "templateFile": "templates/baseline-tests.md",
        "model_profile": "coder-GLM",
        "timeoutSeconds": 3600
      },
      "label": "Capture test baseline",
      "description": "Before any implementation, detect and run the project's test suite(s) (mixed languages -> possibly several) and write {{workspace}}/test-baseline.json recording which tests already fail at the branch point.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 1760
      }
    },
    {
      "id": "record-baseline",
      "type": "script",
      "config": {
        "scriptFile": "scripts/record-baseline.sh",
        "interpreter": "/bin/sh",
        "timeoutSeconds": 60
      },
      "label": "Record baseline vars",
      "description": "Lift {{workspace}}/test-baseline.json into structured vars (test_baseline, test_commands, baseline_summary) so the ralph loop gates on NEW failures vs this baseline rather than a fully green suite.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 1920
      }
    },
    {
      "id": "impl-task",
      "type": "agent_call",
      "config": {
        "templateFile": "templates/impl-task.md",
        "model_profile": "coder-ds4-pro",
        "timeoutSeconds": 3600
      },
      "label": "Implement next task",
      "description": "Implement the next incomplete plan task, strict TDD, commit.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 2080
      }
    },
    {
      "id": "impl-assess",
      "type": "llm_call",
      "config": {
        "templateFile": "templates/impl-assess.md",
        "model_profile": "assessor-opus-low",
        "outputSchema": {
          "properties": {
            "all_tasks_complete": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            },
            "tasks_remaining": {
              "type": "number"
            }
          },
          "required": [
            "all_tasks_complete",
            "tasks_remaining",
            "notes"
          ],
          "type": "object"
        }
      },
      "label": "Assess impl progress",
      "description": "Emit {all_tasks_complete, tasks_remaining, notes}.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 2240
      }
    },
    {
      "id": "impl-inc",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "impl_iteration",
            "operation": "increment",
            "value": 1
          }
        ]
      },
      "label": "impl_iteration++",
      "description": "",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 2400
      }
    },
    {
      "id": "impl-gate",
      "type": "conditional",
      "config": {
        "conditions": [
          {
            "field": "impl-assess.all_tasks_complete",
            "operator": "eq",
            "value": true,
            "output": "exit"
          },
          {
            "field": "impl_iteration",
            "operator": "gte",
            "value": "{{max_impl_iterations}}",
            "output": "exit"
          }
        ],
        "defaultOutput": "loop"
      },
      "label": "Impl loop or exit",
      "description": "Exit when all tasks complete OR iteration cap reached; else loop.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 2560
      }
    },
    {
      "id": "seed-ralph",
      "type": "agent_call",
      "config": {
        "templateFile": "templates/seed-ralph.md",
        "model_profile": "planner-opus-medium",
        "timeoutSeconds": 1800
      },
      "label": "Seed ralph files",
      "description": "Generate RALPH.md/focus-areas.md/gaps-identified.md; commit.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 2720
      }
    },
    {
      "id": "refine",
      "type": "agent_call",
      "config": {
        "templateFile": "templates/refine.md",
        "model_profile": "coder-ds4",
        "timeoutSeconds": 3600
      },
      "label": "Refine (ralph pass)",
      "description": "Smallest correct improvement toward focus areas; run tests; update tracking files; commit.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 2880
      }
    },
    {
      "id": "refine-assess",
      "type": "llm_call",
      "config": {
        "templateFile": "templates/refine-assess.md",
        "model_profile": "assessor-sonnet-high",
        "outputSchema": {
          "properties": {
            "done": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            },
            "progressed": {
              "type": "boolean"
            },
            "consecutive_no_progress": {
              "type": "number"
            }
          },
          "required": [
            "done",
            "notes",
            "progressed",
            "consecutive_no_progress"
          ],
          "type": "object"
        }
      },
      "label": "Assess refinement",
      "description": "Emit {done, notes, progressed, consecutive_no_progress}; done gates on no NEW failures vs the baseline (not a green suite), and consecutive_no_progress drives the stagnation exit.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 3040
      }
    },
    {
      "id": "refine-inc",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "ralph_iteration",
            "operation": "increment",
            "value": 1
          },
          {
            "variable": "no_progress_streak",
            "operation": "set",
            "value": "{{refine-assess.consecutive_no_progress}}"
          }
        ]
      },
      "label": "ralph_iteration++",
      "description": "",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 3200
      }
    },
    {
      "id": "refine-gate",
      "type": "conditional",
      "config": {
        "conditions": [
          {
            "field": "refine-assess.done",
            "operator": "eq",
            "value": true,
            "output": "exit"
          },
          {
            "field": "refine-assess.consecutive_no_progress",
            "operator": "gte",
            "value": 2,
            "output": "exit"
          },
          {
            "field": "ralph_iteration",
            "operator": "gte",
            "value": "{{max_ralph_iterations}}",
            "output": "exit"
          }
        ],
        "defaultOutput": "loop"
      },
      "label": "Refine loop or exit",
      "description": "Exit when done, OR stagnated (2 consecutive no-progress passes), OR ralph cap reached; else loop.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 3360
      }
    },
    {
      "id": "push-and-pr",
      "type": "script",
      "config": {
        "scriptFile": "scripts/push-and-pr.sh",
        "interpreter": "/bin/sh",
        "timeoutSeconds": 300
      },
      "label": "Push & open PR",
      "description": "Push the feature branch and open a GitHub PR (auto-triggers the pr-review workflow on PR open).",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 3520
      }
    },
    {
      "id": "notify-done",
      "type": "script",
      "config": {
        "scriptFile": "scripts/notify.sh",
        "interpreter": "/bin/sh",
        "args": [
          "Feature pipeline complete for {{slug}}: PR {{push-and-pr.pr_url}} opened. PR review will run on open."
        ],
        "timeoutSeconds": 30
      },
      "label": "Notify: PR opened",
      "description": "In-app notification that the PR is open.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 3680
      }
    },
    {
      "id": "done-spec",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "pipeline_status",
            "operation": "set",
            "value": "spec-only-complete"
          }
        ]
      },
      "label": "Done (spec-only, terminal)",
      "description": "Terminal node for the --spec-only path.",
      "errorBehavior": {},
      "position": {
        "x": 520,
        "y": 1600
      }
    },
    {
      "id": "done",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "pipeline_status",
            "operation": "set",
            "value": "complete"
          }
        ]
      },
      "label": "Done (terminal)",
      "description": "Terminal node. Records final status so the walk ends cleanly.",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 3840
      }
    },
    {
      "id": "notify-teams",
      "type": "script",
      "config": {
        "scriptFile": "scripts/notify-teams.sh",
        "interpreter": "/bin/sh",
        "timeoutSeconds": 60,
        "args": [
          "feature-pipeline complete — {{slug}}",
          "Spec, phased designs, plans, implementation and the ralph refinement loop are done; a PR has been opened ({{push-and-pr.pr_url}}). PR review runs automatically on open.",
          "good",
          "Repo={{repo_url}}",
          "Slug={{slug}}",
          "Branch={{branch}}",
          "PR={{push-and-pr.pr_url}}",
          "Status={{pipeline_status}}"
        ]
      },
      "label": "Notify Teams (PR opened)",
      "description": "Rich completion alert to the Teams webhook after the PR is opened (no-op if teams_webhook_url unset).",
      "errorBehavior": {},
      "position": {
        "x": 250,
        "y": 3760
      }
    },
    {
      "id": "notify-teams-spec",
      "type": "script",
      "config": {
        "scriptFile": "scripts/notify-teams.sh",
        "interpreter": "/bin/sh",
        "timeoutSeconds": 60,
        "args": [
          "feature-pipeline (spec-only) complete — {{slug}}",
          "Spec, phased designs and TDD task plans were produced, aligned and checkpoint-pushed. Stopped before implementation (spec_only).",
          "info",
          "Repo={{repo_url}}",
          "Slug={{slug}}",
          "Branch={{branch}}",
          "Status=spec-only-complete"
        ]
      },
      "label": "Notify Teams (spec-only)",
      "description": "Rich alert to the Teams webhook on the spec-only stop (no-op if teams_webhook_url unset).",
      "errorBehavior": {},
      "position": {
        "x": 520,
        "y": 1700
      }
    }
  ],
  "edges": [
    {
      "source": "init-workspace",
      "target": "promote-vars"
    },
    {
      "source": "promote-vars",
      "target": "notify-start"
    },
    {
      "source": "notify-start",
      "target": "brainstorm-spec"
    },
    {
      "source": "brainstorm-spec",
      "target": "repromote-slug"
    },
    {
      "source": "repromote-slug",
      "target": "brainstorm-design"
    },
    {
      "source": "brainstorm-design",
      "target": "align-designs"
    },
    {
      "source": "spec-only?",
      "target": "baseline-tests",
      "output": "continue"
    },
    {
      "source": "align-designs",
      "target": "produce-plans"
    },
    {
      "source": "produce-plans",
      "target": "align-plans"
    },
    {
      "source": "align-plans",
      "target": "checkpoint-push"
    },
    {
      "source": "checkpoint-push",
      "target": "spec-only?"
    },
    {
      "source": "baseline-tests",
      "target": "record-baseline"
    },
    {
      "source": "record-baseline",
      "target": "impl-task"
    },
    {
      "source": "impl-task",
      "target": "impl-assess"
    },
    {
      "source": "impl-assess",
      "target": "impl-inc"
    },
    {
      "source": "impl-inc",
      "target": "impl-gate"
    },
    {
      "source": "impl-gate",
      "target": "impl-task",
      "output": "loop",
      "label": "back-edge: next task"
    },
    {
      "source": "impl-gate",
      "target": "seed-ralph",
      "output": "exit"
    },
    {
      "source": "seed-ralph",
      "target": "refine"
    },
    {
      "source": "refine",
      "target": "refine-assess"
    },
    {
      "source": "refine-assess",
      "target": "refine-inc"
    },
    {
      "source": "refine-inc",
      "target": "refine-gate"
    },
    {
      "source": "refine-gate",
      "target": "refine",
      "output": "loop",
      "label": "back-edge: another pass"
    },
    {
      "source": "refine-gate",
      "target": "push-and-pr",
      "output": "exit"
    },
    {
      "source": "push-and-pr",
      "target": "notify-done"
    },
    {
      "source": "notify-done",
      "target": "notify-teams"
    },
    {
      "source": "notify-teams",
      "target": "done"
    },
    {
      "source": "spec-only?",
      "target": "notify-teams-spec",
      "output": "stop"
    },
    {
      "source": "notify-teams-spec",
      "target": "done-spec"
    }
  ]
}
