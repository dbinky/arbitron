{
  "id": "5087a284-f403-4a95-a2f8-f9292c7b1f7e",
  "name": "feature-pipeline",
  "description": "Composable feature pipeline. Intake picks fresh, idea or resume mode, clones, and detects the next stage from the branch's pipeline manifest; then it runs the stage workflows ideate, spec, design, plan, implement, harden, ralph-loop (refine) and pr-review (review) as awaited children with fully mapped inputs, recording refine and review in the manifest. Acyclic: a stage failure or block notifies and halts; resume by rerunning with branch.",
  "author": "arbitron",
  "defaultErrorBehavior": {
    "type": "route",
    "errorNodeId": "notify-step-failed"
  },
  "inputs": [
    {
      "name": "repo_url",
      "type": "string",
      "description": "GitHub repo URL to clone (file:// for tests).",
      "required": true
    },
    {
      "name": "base_branch",
      "type": "string",
      "description": "Branch the feature is cut from and its PR targets. Empty resolves once: main for fresh and idea runs, the manifest's recorded base_branch on resume (P2b). An explicit value always wins.",
      "default": "",
      "required": false
    },
    {
      "name": "topic",
      "type": "string",
      "description": "Optional opening topic for a fresh ideate jam.",
      "default": "",
      "required": false
    },
    {
      "name": "idea_path",
      "type": "string",
      "description": "Existing idea doc to start from. Without branch, cuts a new branch from base_branch and skips ideate; with branch, records it on the resumed branch.",
      "default": "",
      "required": false
    },
    {
      "name": "branch",
      "type": "string",
      "description": "Existing pipeline branch to resume. Empty starts a new feature.",
      "default": "",
      "required": false
    },
    {
      "name": "slug",
      "type": "string",
      "description": "Feature slug; disambiguates a resumed branch holding several manifests.",
      "default": "",
      "required": false
    },
    {
      "name": "start_at",
      "type": "string",
      "description": "Force the next stage (ideate, spec, design, plan, implement, harden, refine, review). Empty detects it from the manifest.",
      "default": "",
      "required": false
    },
    {
      "name": "review_fix_scope",
      "type": "string",
      "description": "pr-review fix_scope for the review stage.",
      "default": "all-but-defer",
      "required": false
    },
    {
      "name": "teams_webhook_url",
      "type": "string",
      "description": "Teams webhook URL for alerts. Leave empty in the committed sample.",
      "default": "",
      "required": false
    }
  ],
  "nodes": [
    {
      "id": "intake",
      "type": "script",
      "config": {
        "scriptFile": "scripts/intake.sh",
        "interpreter": "/bin/sh",
        "args": [],
        "timeoutSeconds": 60
      },
      "label": "Intake",
      "description": "Validation only, no git. Picks the mode (resume: branch given; idea: idea_path given; fresh: neither), applies the pre-clone mode rules, derives repo_slug and resolves base_branch for fresh and idea mode. Emits {mode, init_mode, slug, repo_slug, base_branch}.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 0
      },
      "entrypoint": true
    },
    {
      "id": "promote-intake",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "init_mode",
            "operation": "set",
            "value": "{{intake.init_mode}}"
          },
          {
            "variable": "slug",
            "operation": "set",
            "value": "{{intake.slug}}"
          },
          {
            "variable": "repo_slug",
            "operation": "set",
            "value": "{{intake.repo_slug}}"
          },
          {
            "variable": "base_branch",
            "operation": "set",
            "value": "{{intake.base_branch}}"
          }
        ]
      },
      "label": "Promote intake",
      "description": "Lift init_mode, slug, repo_slug and base_branch to top-level vars before the clone.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 140
      }
    },
    {
      "id": "clone",
      "type": "script",
      "config": {
        "scriptFile": "@lib/init-workspace.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--mode-var",
          "init_mode"
        ],
        "timeoutSeconds": 600
      },
      "label": "Clone",
      "description": "Clone repo_url and add ./work in the intake's mode: checkout (resume), new-branch from base_branch (idea), or detached at base_branch (fresh).",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 280
      }
    },
    {
      "id": "intake-check",
      "type": "script",
      "config": {
        "scriptFile": "scripts/intake-check.sh",
        "interpreter": "/bin/sh",
        "args": [],
        "timeoutSeconds": 60
      },
      "label": "Intake check",
      "description": "Applies the mode rules that need the clone (slug discovery, idea_path on the branch, a resume with nothing to start from) and resolves base_branch from the manifest on resume (P2b). Emits {slug, branch, work_dir, idea_path, record_idea, base_branch}.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 420
      }
    },
    {
      "id": "promote-check",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "slug",
            "operation": "set",
            "value": "{{intake-check.slug}}"
          },
          {
            "variable": "branch",
            "operation": "set",
            "value": "{{intake-check.branch}}"
          },
          {
            "variable": "work_dir",
            "operation": "set",
            "value": "{{intake-check.work_dir}}"
          },
          {
            "variable": "base_branch",
            "operation": "set",
            "value": "{{intake-check.base_branch}}"
          }
        ]
      },
      "label": "Promote check",
      "description": "Lift the resolved slug, branch, work_dir and base_branch; every later node reads these top-level values.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 560
      }
    },
    {
      "id": "record-idea?",
      "type": "conditional",
      "config": {
        "conditions": [
          {
            "field": "intake-check.record_idea",
            "operator": "eq",
            "value": true,
            "output": "record"
          }
        ],
        "defaultOutput": "skip"
      },
      "label": "Record a provided idea?",
      "description": "intake-check.record_idea is a script output: true in idea mode and on a resume given idea_path. Recording the provided idea makes detection treat ideate as done.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 700
      }
    },
    {
      "id": "record-provided-idea",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-append.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--workflow",
          "feature-pipeline",
          "ideate",
          "done",
          "{slug: .slug, branch: .branch, idea_path: .[\"intake-check\"].idea_path, provided: true}"
        ],
        "timeoutSeconds": 300
      },
      "label": "Record provided idea",
      "description": "Append a done ideate entry for the provided idea doc. In idea mode this pushes the new branch and creates the manifest; on resume it appends to the existing one.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 420,
        "y": 770
      }
    },
    {
      "id": "fresh?",
      "type": "conditional",
      "config": {
        "conditions": [
          {
            "field": "intake.mode",
            "operator": "eq",
            "value": "fresh",
            "output": "fresh"
          }
        ],
        "defaultOutput": "detect"
      },
      "label": "Fresh run?",
      "description": "Fresh mode has no slug or manifest yet, so it goes straight to ideate without detection (P1). intake.mode is a script output.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 840
      }
    },
    {
      "id": "detect",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-read.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--fetch",
          "--order",
          "ideate,spec,design,plan,implement,harden,refine,review",
          "--start-at-var",
          "start_at"
        ],
        "timeoutSeconds": 120
      },
      "label": "Detect next stage",
      "description": "Read the branch's manifest from origin and pick the next stage: start_at if given, else the first stage whose latest entry is not done, else complete.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 980
      }
    },
    {
      "id": "route",
      "type": "conditional",
      "config": {
        "conditions": [
          {
            "field": "detect.next_stage",
            "operator": "eq",
            "value": "ideate",
            "output": "ideate"
          },
          {
            "field": "detect.next_stage",
            "operator": "eq",
            "value": "spec",
            "output": "spec"
          },
          {
            "field": "detect.next_stage",
            "operator": "eq",
            "value": "design",
            "output": "design"
          },
          {
            "field": "detect.next_stage",
            "operator": "eq",
            "value": "plan",
            "output": "plan"
          },
          {
            "field": "detect.next_stage",
            "operator": "eq",
            "value": "implement",
            "output": "implement"
          },
          {
            "field": "detect.next_stage",
            "operator": "eq",
            "value": "harden",
            "output": "harden"
          },
          {
            "field": "detect.next_stage",
            "operator": "eq",
            "value": "refine",
            "output": "refine"
          },
          {
            "field": "detect.next_stage",
            "operator": "eq",
            "value": "review",
            "output": "review"
          },
          {
            "field": "detect.next_stage",
            "operator": "eq",
            "value": "complete",
            "output": "complete"
          }
        ],
        "defaultOutput": "unknown"
      },
      "label": "Route to stage",
      "description": "Route on detect.next_stage, a script output. An unknown value is a pipeline step failure.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 1120
      }
    },
    {
      "id": "ideate",
      "type": "spawn_workflow",
      "config": {
        "childWorkflow": "ideate",
        "spawnMode": "wait_for_child",
        "inputs": {
          "repo_url": "{{repo_url}}",
          "base_branch": "{{base_branch}}",
          "topic": "{{topic}}",
          "teams_webhook_url": "{{teams_webhook_url}}"
        }
      },
      "label": "Stage: ideate",
      "description": "Awaited ideate child: the idea jam, which cuts the feature branch and creates the manifest.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 1260
      }
    },
    {
      "id": "adopt-ideate",
      "type": "script",
      "config": {
        "scriptFile": "scripts/adopt-ideate.sh",
        "interpreter": "/bin/sh",
        "args": [],
        "timeoutSeconds": 30
      },
      "label": "Adopt ideate result",
      "description": "Fail closed on ideate's finish outputs: emit {branch, slug}, or exit 1 when either is missing, empty or not a string.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 1400
      }
    },
    {
      "id": "promote-ideate",
      "type": "transform",
      "config": {
        "operations": [
          {
            "variable": "branch",
            "operation": "set",
            "value": "{{adopt-ideate.branch}}"
          },
          {
            "variable": "slug",
            "operation": "set",
            "value": "{{adopt-ideate.slug}}"
          }
        ]
      },
      "label": "Promote ideate",
      "description": "Adopt the branch and slug ideate created.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 1540
      }
    },
    {
      "id": "pre-spec",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-read.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--fetch",
          "--explicit",
          "idea_path",
          "--optional",
          "idea_path="
        ],
        "timeoutSeconds": 120
      },
      "label": "Read inputs: spec",
      "description": "An explicit idea_path wins; else the manifest's (provided or ideate) idea_path; else empty.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 1680
      }
    },
    {
      "id": "spec",
      "type": "spawn_workflow",
      "config": {
        "childWorkflow": "spec",
        "spawnMode": "wait_for_child",
        "inputs": {
          "repo_url": "{{repo_url}}",
          "branch": "{{branch}}",
          "slug": "{{slug}}",
          "base_branch": "{{base_branch}}",
          "idea_path": "{{pre-spec.inputs.idea_path}}",
          "teams_webhook_url": "{{teams_webhook_url}}"
        }
      },
      "label": "Stage: spec",
      "description": "Awaited spec child: the interactive product-spec interview.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 1820
      }
    },
    {
      "id": "pre-design",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-read.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--fetch",
          "--explicit",
          "idea_path",
          "--require",
          "spec_path",
          "--optional",
          "idea_path="
        ],
        "timeoutSeconds": 120
      },
      "label": "Read inputs: design",
      "description": "spec_path must be recorded; idea_path as for spec.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 1960
      }
    },
    {
      "id": "design",
      "type": "spawn_workflow",
      "config": {
        "childWorkflow": "design",
        "spawnMode": "wait_for_child",
        "inputs": {
          "repo_url": "{{repo_url}}",
          "branch": "{{branch}}",
          "slug": "{{slug}}",
          "base_branch": "{{base_branch}}",
          "spec_path": "{{pre-design.inputs.spec_path}}",
          "idea_path": "{{pre-design.inputs.idea_path}}",
          "teams_webhook_url": "{{teams_webhook_url}}"
        }
      },
      "label": "Stage: design",
      "description": "Awaited design child: the interactive design session and alignment.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 2100
      }
    },
    {
      "id": "pre-plan",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-read.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--fetch",
          "--require",
          "spec_path,design_paths"
        ],
        "timeoutSeconds": 120
      },
      "label": "Read inputs: plan",
      "description": "spec_path and design_paths (typed array) must be recorded.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 2240
      }
    },
    {
      "id": "plan",
      "type": "spawn_workflow",
      "config": {
        "childWorkflow": "plan",
        "spawnMode": "wait_for_child",
        "inputs": {
          "repo_url": "{{repo_url}}",
          "branch": "{{branch}}",
          "slug": "{{slug}}",
          "base_branch": "{{base_branch}}",
          "spec_path": "{{pre-plan.inputs.spec_path}}",
          "design_paths": "{{pre-plan.inputs.design_paths}}",
          "teams_webhook_url": "{{teams_webhook_url}}"
        }
      },
      "label": "Stage: plan",
      "description": "Awaited plan child: plans, alignment and the dependency gate.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 2380
      }
    },
    {
      "id": "plan-ok?",
      "type": "conditional",
      "config": {
        "conditions": [
          {
            "field": "plan.childOutput.finish.outputs.deps_resolved",
            "operator": "eq",
            "value": true,
            "output": "ok"
          }
        ],
        "defaultOutput": "blocked"
      },
      "label": "Plan dependencies resolved?",
      "description": "deps_resolved comes from plan's deps-count script, recorded by its finish. A plan blocked on unresolved dependencies stops the pipeline; absence reads as blocked.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 2520
      }
    },
    {
      "id": "pre-implement",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-read.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--fetch",
          "--require",
          "plan_paths"
        ],
        "timeoutSeconds": 120
      },
      "label": "Read inputs: implement",
      "description": "plan_paths (typed array) must be recorded.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 2660
      }
    },
    {
      "id": "implement",
      "type": "spawn_workflow",
      "config": {
        "childWorkflow": "implement",
        "spawnMode": "wait_for_child",
        "inputs": {
          "repo_url": "{{repo_url}}",
          "branch": "{{branch}}",
          "slug": "{{slug}}",
          "base_branch": "{{base_branch}}",
          "plan_paths": "{{pre-implement.inputs.plan_paths}}",
          "teams_webhook_url": "{{teams_webhook_url}}"
        }
      },
      "label": "Stage: implement",
      "description": "Awaited implement child: the tamper-gated implementation loop.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 2800
      }
    },
    {
      "id": "impl-ok?",
      "type": "conditional",
      "config": {
        "conditions": [
          {
            "field": "implement.childOutput.finish.status",
            "operator": "eq",
            "value": "done",
            "output": "ok"
          }
        ],
        "defaultOutput": "blocked"
      },
      "label": "Implementation done?",
      "description": "finish.status is implement's manifest status (done or blocked), set from count-plan-steps arithmetic. Blocked stops the pipeline.",
      "errorBehavior": {},
      "position": {
        "x": 0,
        "y": 2940
      }
    },
    {
      "id": "pre-harden",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-read.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--fetch",
          "--explicit",
          "base_branch",
          "--require",
          "base_branch",
          "--optional",
          "baseline_path="
        ],
        "timeoutSeconds": 120
      },
      "label": "Read inputs: harden",
      "description": "base_branch is the resolved top-level value (manifest as fallback); baseline_path from implement.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 3080
      }
    },
    {
      "id": "harden",
      "type": "spawn_workflow",
      "config": {
        "childWorkflow": "harden",
        "spawnMode": "wait_for_child",
        "inputs": {
          "repo_url": "{{repo_url}}",
          "branch": "{{branch}}",
          "slug": "{{slug}}",
          "base_branch": "{{base_branch}}",
          "base_ref": "{{pre-harden.inputs.base_branch}}",
          "baseline_path": "{{pre-harden.inputs.baseline_path}}",
          "teams_webhook_url": "{{teams_webhook_url}}"
        }
      },
      "label": "Stage: harden",
      "description": "Awaited harden child: diff-scoped mutation hardening. A gate miss is still success; its survivors seed ralph.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 3220
      }
    },
    {
      "id": "pre-refine",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-read.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--fetch",
          "--explicit",
          "base_branch",
          "--require",
          "base_branch",
          "--optional",
          "focus_seed_path=",
          "--optional",
          "baseline_path="
        ],
        "timeoutSeconds": 120
      },
      "label": "Read inputs: refine",
      "description": "base_branch becomes ralph's PR base; focus_seed_path (harden survivors on a miss, else empty) and baseline_path from the manifest.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 3360
      }
    },
    {
      "id": "refine",
      "type": "spawn_workflow",
      "config": {
        "childWorkflow": "ralph-loop",
        "spawnMode": "wait_for_child",
        "inputs": {
          "repo_url": "{{repo_url}}",
          "base_branch": "{{branch}}",
          "slug": "{{slug}}",
          "pr_base": "{{pre-refine.inputs.base_branch}}",
          "in_place": true,
          "focus_seed": "{{pre-refine.inputs.focus_seed_path}}",
          "baseline_path": "{{pre-refine.inputs.baseline_path}}",
          "teams_webhook_url": "{{teams_webhook_url}}"
        }
      },
      "label": "Stage: refine",
      "description": "Awaited ralph-loop child, in place on the feature branch; it opens the PR into base_branch.",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 3500
      }
    },
    {
      "id": "record-refine",
      "type": "script",
      "config": {
        "scriptFile": "@lib/manifest-append.sh",
        "interpreter": "/bin/sh",
        "args": [
          "--workflow",
          "feature-pipeline",
          "--no-skip-ci",
          "refine",
          "done",
          "{pr_number: .refine.childOutput[\"push-and-pr\"].pr_number, pr_url: .refine.childOutput[\"push-and-pr\"].pr_url} | if (.pr_number | type) != \"number\" then error(\"ralph-loop opened no PR\") else . end"
        ],
        "timeoutSeconds": 300
      },
      "label": "Record refine",
      "description": "Record ralph's PR (pr_number stays a number). No PR fails the step. --no-skip-ci: this manifest commit lands on top of ralph's one CI commit and becomes the PR head, so it must not carry [skip ci].",
      "errorBehavior": {
        "type": "route",
        "errorNodeId": "notify-step-failed"
      },
      "position": {
        "x": 0,
        "y": 3640
      }
