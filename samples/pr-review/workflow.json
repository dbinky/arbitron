{
  "author": "arbitron",
  "defaultErrorBehavior": {
    "retries": 2,
    "retryDelaySeconds": 30,
    "type": "retry"
  },
  "description": "Multi-persona PR review pipeline (Architect R1 -> 10x R1 -> Architect R2 -> 10x R2 -> Security -> Manager) with optional senior-engineer auto-implement of selected fix tier. Intended to be triggered by a GitHub Action on PR open/update.",
  "edges": [
    {
      "source": "architect-r1",
      "target": "10x-r1"
    },
    {
      "source": "10x-r1",
      "target": "architect-r2"
    },
    {
      "source": "architect-r2",
      "target": "10x-r2"
    },
    {
      "source": "10x-r2",
      "target": "security"
    },
    {
      "source": "security",
      "target": "manager"
    },
    {
      "source": "manager",
      "target": "branch-on-scope"
    },
    {
      "output": "implement",
      "source": "branch-on-scope",
      "target": "senior-engineer"
    },
    {
      "output": "skip",
      "source": "branch-on-scope",
      "target": "skipped"
    }
  ],
  "inputs": [
    {
      "description": "GitHub PR number to review",
      "name": "pr_number",
      "required": true,
      "type": "number"
    },
    {
      "description": "GitHub repo in owner/name format (e.g. dbinky/arbitron). Must be cloned into ~/Repos/<owner>/<name> on the container host.",
      "name": "repo",
      "required": true,
      "type": "string"
    },
    {
      "default": "must-should",
      "description": "Auto-implement tier. One of: must, must-should, all-but-defer, none. 'none' skips the senior-engineer node entirely.",
      "name": "fix_scope",
      "required": true,
      "type": "string"
    }
  ],
  "name": "pr-review",
  "nodes": [
    {
      "config": {
        "templateFile": "architect-r1.md",
        "model_profile": "reviewer-codex-medium"
      },
      "description": "Ivory Tower Architect first pass; posts inline + general comments",
      "entrypoint": true,
      "errorBehavior": {},
      "id": "architect-r1",
      "label": "Architect R1",
      "position": {
        "x": 130,
        "y": 0
      },
      "type": "agent_call"
    },
    {
      "config": {
        "templateFile": "10x-r1.md",
        "model_profile": "reviewer-ds4-pro"
      },
      "description": "10x GSD Engineer first pass; replies to architect threads, adds practical findings",
      "errorBehavior": {},
      "id": "10x-r1",
      "label": "10x R1",
      "position": {
        "x": 130,
        "y": 160
      },
      "type": "agent_call"
    },
    {
      "config": {
        "templateFile": "architect-r2.md",
        "model_profile": "reviewer-codex-medium"
      },
      "description": "Architect second pass; concedes or doubles down in existing threads only",
      "errorBehavior": {},
      "id": "architect-r2",
      "label": "Architect R2",
      "position": {
        "x": 130,
        "y": 320
      },
      "type": "agent_call"
    },
    {
      "config": {
        "templateFile": "10x-r2.md",
        "model_profile": "reviewer-ds4-pro"
      },
      "description": "10x second pass; final positions in existing threads",
      "errorBehavior": {},
      "id": "10x-r2",
      "label": "10x R2",
      "position": {
        "x": 130,
        "y": 480
      },
      "type": "agent_call"
    },
    {
      "config": {
        "templateFile": "security.md",
        "model_profile": "reviewer-opus-high"
      },
      "description": "Security expert; weighs in on existing debates and posts severity-tagged findings",
      "errorBehavior": {},
      "id": "security",
      "label": "Security",
      "position": {
        "x": 130,
        "y": 640
      },
      "type": "agent_call"
    },
    {
      "config": {
        "templateFile": "manager.md",
        "model_profile": "reviewer-sonnet-high"
      },
      "description": "Engineering manager; per-thread decisions + Decision Summary with verdict",
      "errorBehavior": {},
      "id": "manager",
      "label": "Manager",
      "position": {
        "x": 130,
        "y": 800
      },
      "type": "agent_call"
    },
    {
      "config": {
        "conditions": [
          {
            "field": "fix_scope",
            "operator": "neq",
            "output": "implement",
            "value": "none"
          }
        ],
        "defaultOutput": "skip"
      },
      "description": "Skip senior-engineer when fix_scope == 'none'",
      "errorBehavior": {},
      "id": "branch-on-scope",
      "label": "Implement?",
      "position": {
        "x": 130,
        "y": 960
      },
      "type": "conditional"
    },
    {
      "config": {
        "templateFile": "senior-engineer.md",
        "model_profile": "coder-opus-medium"
      },
      "description": "Implements selected fix tier locally on the PR branch; does NOT push (manual review before push)",
      "errorBehavior": {},
      "id": "senior-engineer",
      "label": "Senior Engineer",
      "position": {
        "x": 0,
        "y": 1120
      },
      "type": "agent_call"
    },
    {
      "config": {},
      "description": "No-op terminal node reached when fix_scope == 'none'",
      "errorBehavior": {},
      "id": "skipped",
      "label": "Skipped (review-only)",
      "position": {
        "x": 260,
        "y": 1120
      },
      "type": "transform"
    }
  ]
}
